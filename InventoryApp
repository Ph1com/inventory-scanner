<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Inventory Mobile App</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      padding: 15px;
      background: #f5f5f5;
    }
    h2 {
      margin-top: 25px;
      border-bottom: 1px solid #ccc;
      padding-bottom: 5px;
    }
    label {
      font-weight: bold;
      margin-top: 10px;
      display: block;
    }
    input, select, textarea {
      width: 100%;
      padding: 10px;
      margin-top: 5px;
      font-size: 16px;
      box-sizing: border-box;
    }
    button {
      width: 100%;
      padding: 12px;
      margin-top: 12px;
      font-size: 18px;
      background: #333;
      color: white;
      border: none;
      border-radius: 5px;
    }
    #scannerContainer {
      display: none;
      margin-top: 15px;
      padding: 10px;
      background: #fff;
      border: 1px solid #ccc;
      border-radius: 5px;
    }
    #reader {
      width: 100%;
      max-width: 320px;
      margin: 0 auto;
    }
  </style>

  <script src="https://unpkg.com/html5-qrcode"></script>
  <script src="scanner.js"></script>
</head>

<body>

<h2>Asset</h2>

<label>Asset Number (scan or type)</label>
<input id="assetNumber" type="text">

<button onclick="loadItem()">Load / Edit Item</button>
<button onclick="openScanner()">Scan Barcode</button>

<div id="scannerContainer">
  <div id="reader"></div>
  <button onclick="closeScanner()">Close Scanner</button>
</div>

<h2>Add / Edit Details</h2>

<label>Category</label>
<select id="category">
  <option value="">-- Select --</option>
  <option>Bread Slicer</option>
  <option>Divider/Moulder/BDM</option>
  <option>Fridges & Freezers</option>
  <option>Mixer</option>
  <option>Oven</option>
  <option>Pastry Sheeter</option>
  <option>Prover/Retarder</option>
  <option>Table/Stand</option>
  <option>Trays</option>
  <option>Trolley/Rack</option>
  <option>Pie Stamper/Stamp/Dies</option>
  <option>Sink</option>
  <option>Bagel Boiler</option>
  <option>Baskets</option>
  <option>Dollies</option>
  <option>L Sealer/Baggers</option>
  <option>Roll Plant</option>
  <option>Tins</option>
  <option>Ancilliary</option>
  <option>Other</option>
</select>

<label>Make</label>
<input id="make" type="text">

<label>Model</label>
<input id="model" type="text">

<label>Description</label>
<textarea id="description"></textarea>

<label>Location</label>
<select id="location">
  <option value="">-- Select --</option>
  <option>Barn1-Stores</option>
  <option>Barn1-Workshop</option>
  <option>Barn2</option>
</select>

<label>Original Qty</label>
<input id="originalQty" type="number">

<label>Current Qty</label>
<input id="currentQty" type="number">

<label>Cost per Item (£)</label>
<input id="costPerItem" type="number" step="0.01">

<label>Supplier</label>
<input id="supplier" type="text">

<button onclick="addNewItem()">Add New Item</button>
<button onclick="saveChanges()">Save Changes</button>

<h2>Move Location</h2>

<label>New Location</label>
<select id="newLocation">
  <option value="">-- Select --</option>
  <option>Barn1-Stores</option>
  <option>Barn1-Workshop</option>
  <option>Barn2</option>
</select>

<button onclick="moveLocation()">Move</button>

<h2>Update Quantity</h2>

<label>Change (e.g. -1, +3)</label>
<input id="qtyChange" type="number">
<button onclick="applyQtyChange()">Apply</button>

<h2>Photos</h2>

<input type="file" id="photoFile" accept="image/*">
<button onclick="uploadPhoto()">Upload Photo</button>

</body>
</html>
